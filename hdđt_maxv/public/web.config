<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS config cho hdđt_maxv (production).
  Vite tự copy file trong public/ sang dist/ khi build -> IIS đọc từ dist/.

  Kiến trúc: IIS :443 là cổng vào duy nhất.
    /api/*  -> ARR rewrite -> Node/Fastify localhost:4000
    /*      -> file tĩnh, không khớp file nào thì trả index.html (SPA)
  FE và API CÙNG origin (https://test.wweb.io.vn) nên cookie sameSite của
  be_maxv (access 'lax', refresh 'strict') hoạt động. Đừng tách domain API.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1. API: phải ĐỨNG TRƯỚC rule SPA, nếu không /api/* sẽ bị nuốt thành index.html.
             Yêu cầu: IIS Manager > node server > ARR Cache > Server Proxy Settings > Enable proxy. -->
        <rule name="ProxyApi" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:4000/api/{R:1}" />
        </rule>

        <!-- 2. Ép HTTPS: cookie của be_maxv có secure:true ở production nên
             KHÔNG bao giờ gửi qua http:// -> vào bằng http là auth chết câm. -->
        <rule name="ForceHttps" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 3. SPA fallback: react-router định tuyến ở client. Thiếu rule này thì
             F5 tại /hoa-don sẽ ra 404 vì IIS đi tìm file thật tên 'hoa-don'. -->
        <rule name="SpaFallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <!-- Vite gắn hash vào tên file asset (index-a1b2c3.js) nên cache 1 năm là an toàn.
           index.html KHÔNG được cache (xem httpProtocol bên dưới) để deploy mới ăn ngay. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- Ẩn thông tin phiên bản IIS/ASP.NET -->
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
  </system.webServer>

  <!-- index.html KHÔNG cache: nó tham chiếu tới các file asset có hash. Nếu bị cache
       1 năm theo clientCache ở trên, người dùng sẽ mãi tải bản cũ sau mỗi lần deploy. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
