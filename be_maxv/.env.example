# ============================================================
#  be_maxv — MẪU biến môi trường (KHÔNG chứa secret thật)
#  Copy file này thành `.env.local` rồi điền giá trị thật.
#  LƯU Ý: app đọc từ `.env.local` (không phải `.env`) — xem src/config/env.ts
# ============================================================

# ---- Server ----
PORT=4000
NODE_ENV=development                 # đặt `production` khi deploy (bật cookie Secure + bắt buộc CORS)
TRUST_PROXY=false                    # `true` khi chạy sau nginx/reverse proxy (đọc IP thật từ X-Forwarded-For)

# ---- CORS: domain FE được phép gọi API (BẮT BUỘC khi NODE_ENV=production) ----
# Nhiều domain cách nhau bằng dấu phẩy, KHÔNG có dấu "/" ở cuối.
# Dev: bỏ trống -> mặc định http://localhost:5173, http://localhost:5174
ALLOWED_ORIGINS=

# ---- Control plane DB (maxv2_sys) — URL đầy đủ, runtime dùng trực tiếp [BẮT BUỘC] ----
DB_SYS_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/maxv2_sys?schema=public

# ---- Postgres server chứa DB tenant + quyền CREATE/DROP DATABASE (thường CÙNG server với DB_SYS_URL) [BẮT BUỘC] ----
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5432
APP_DB_USER=USER
APP_DB_PASSWORD=PASSWORD

# ---- JWT — chuỗi ngẫu nhiên DÀI, MỖI secret khác nhau [BẮT BUỘC] ----
# Sinh bằng: openssl rand -hex 64   (chạy 2 lần cho 2 secret khác nhau)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m                 # tùy chọn (mặc định 15m)
REFRESH_TOKEN_TTL_SEC=604800         # tùy chọn (mặc định 7 ngày, tính bằng GIÂY)

# ---- SMTP — gửi email (vd báo admin khi mời nhân viên) [BẮT BUỘC] ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                        # tùy chọn (mặc định 587)
SMTP_USER=you@example.com
SMTP_PASSWORD=                       # Gmail: dùng App Password, không dùng mật khẩu thường

# ---- Tùy chọn ----
TRIAL_DAYS=7                         # số ngày dùng thử (mặc định 7)
# DEV_TENANT_DB=                     # CHỈ dev: cố định 1 DB tenant khi chưa có luồng auth thật; production để trống

# ---- Chỉ khi Prisma CLI (migrate:sys) báo thiếu URL: đặt bằng đúng DB_SYS_URL ----
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/maxv2_sys?schema=public
