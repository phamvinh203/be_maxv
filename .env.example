# ============================================================
#  Biến cho docker-compose (đọc tự động từ file `.env` cạnh docker-compose.yml)
#  Copy thành `.env` rồi điền giá trị THẬT. KHÔNG commit `.env`.
# ============================================================

# Mật khẩu superuser Postgres trong container (đặt mạnh)
POSTGRES_PASSWORD=doi_mat_khau_manh

# Domain FE (CORS) — đúng origin người dùng truy cập
ALLOWED_ORIGINS=https://hddt.tencongty.com

# ---- HTTPS (chỉ dùng khi chạy production với docker-compose.prod.yml / Caddy) ----
# Domain thật đã trỏ DNS về IP server + email cho Let's Encrypt.
DOMAIN=hddt.tencongty.com
ACME_EMAIL=admin@tencongty.com
# Test local: BỎ TRỐNG (dùng web trực tiếp qua WEB_PORT, không cần Caddy)
# WEB_PORT=8080
# NODE_ENV=development

# JWT — chuỗi ngẫu nhiên DÀI, mỗi cái khác nhau: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=app_password
SMTP_FROM=noreply@tencongty.com

# Khóa mã hóa mật khẩu HĐĐT (AES-256-GCM), 32 byte hex: openssl rand -hex 32
# GIỮ nguyên khóa cũ nếu đã có dữ liệu mã hóa (đổi -> giải mã hỏng).
HDDT_ENC_KEY=
