// ============================================================
//  maxv2_sys — CONTROL PLANE (nguồn sự thật duy nhất)
//  Người dùng, công ty (tenant), gói thuê bao, lời mời, nhật ký.
//  KHÔNG chứa dữ liệu nghiệp vụ/chứng từ.
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/sys"
}

// Prisma 7: URL kết nối chuyển sang prisma.config.ts (Migrate/CLI)
// và driver adapter @prisma/adapter-pg (runtime client).
datasource db {
  provider = "postgresql"
}

// ---------------- Người dùng ----------------
model User {
  id       String     @id @default(uuid())
  email    String     @unique
  sdt      String? // số điện thoại
  password String // hash bcrypt
  hoTen    String
  chucVu   String? // chức vụ tự do (chỉ có ý nghĩa với OWNER_EMPLOYEE, sao chép từ InviteRequest lúc duyệt)
  role     Role       @default(OWNER) // OWNER = chủ tài khoản (mua gói); OWNER_EMPLOYEE = nhân viên
  status   UserStatus @default(ACTIVE)
  isActive Boolean    @default(false) // true sau khi xác thực email / được duyệt

  // Nhúng vào JWT; tăng lên khi đổi/đặt lại mật khẩu để vô hiệu MỌI refresh token đã phát.
  // loadUserForRefresh so version trong token với cột này -> lệch là chặn.
  tokenVersion Int @default(0)

  // Chủ tài khoản (owner) = đơn vị billing. Nhân viên trỏ ownerId về owner; owner/admin = null.
  ownerId   String?
  owner     User?   @relation("AccountMembers", fields: [ownerId], references: [id], onDelete: Cascade)
  employees User[]  @relation("AccountMembers")

  // Các MST owner sở hữu (do owner tạo) + thuê bao của owner (1:1, chỉ owner)
  ownedDonVi   DonVi[]       @relation("DonViOwner")
  subscription Subscription?

  // MST mà user (nhân viên) được cấp quyền truy cập — bảng nối "list donVi"
  donViAccess DonViAccess[]

  // Lời mời nhân viên do owner này tạo
  invites InviteRequest[] @relation("AccountInvites")

  // OTP đặt lại mật khẩu đã phát cho user này
  passwordResetOtps PasswordResetOtp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("users")
}

// ---------------- Công ty (tenant) ----------------
model DonVi {
  id       String @id @default(uuid())
  maSoThue String @unique // 1 MST = 1 công ty (1 gói)
  slug     String @unique
  tenDonVi String

  diaChi            String? // địa chỉ trụ sở
  sdt               String? // số điện thoại công ty
  loaiHinhKinhDoanh String? // loại hình kinh doanh (hộ KD, công ty TNHH, CP...)

  // Mật khẩu cổng thuế (GDT) đã lưu — DÙNG CHUNG cho mọi user có quyền trên MST này, để lần sau
  // (kể cả trình duyệt khác) khỏi gõ lại. Mã hóa AES-256-GCM (xem services/client/hddt/gdtCredential.ts):
  // KHÔNG bao giờ lưu plaintext, KHÔNG hash (phải giải ngược để đăng nhập hộ). null = chưa lưu; cả ba
  // cột luôn cùng null hoặc cùng có giá trị (bất biến giữ ở tầng service, không ở DB).
  gdtPasswordCipher String? // ciphertext (base64)
  gdtPasswordIv     String? // IV/nonce 12 byte (base64)
  gdtPasswordTag    String? // GCM auth tag (base64)

  // Tài khoản/mật khẩu cổng Dịch vụ công (DVC) đã lưu — cùng cơ chế với gdtPassword* ở trên,
  // dùng lại chung services/client/hddt/gdtCredential.ts (thuần crypto, không đụng Prisma nên
  // tái dùng được cho cột khác). LƯU CẢ tên đăng nhập: quy ước "<MST>-ql" không chắc đúng cho
  // mọi đơn vị, nên phải lưu tên thật đã đăng nhập thành công thay vì suy lại từ MST lúc cần
  // đăng nhập lại. null = chưa lưu; ba cột dvcPassword* luôn cùng null hoặc cùng có giá trị.
  dvcUsername       String? // tên đăng nhập cổng DVC đã đăng nhập thành công gần nhất
  dvcPasswordCipher String? // ciphertext (base64)
  dvcPasswordIv     String? // IV/nonce 12 byte (base64)
  dvcPasswordTag    String? // GCM auth tag (base64)

  // Google Drive của công ty — nơi lưu FILE SCAN hồ sơ nhân sự (dữ liệu nhập liệu vẫn ở DB
  // tenant). Cùng cơ chế mã hóa AES-256-GCM với gdtPassword*/dvcPassword* ở trên: refresh token
  // phải giải ngược được để backend gọi Drive hộ, nên mã hóa chứ không hash.
  //
  // File nằm trên Drive CỦA KHÁCH, không phải của maxv — mất tài khoản Google là mất file, mình
  // không khôi phục được (đã cân nhắc: đổi lại là không phải mua Workspace, không tốn dung lượng,
  // và ảnh CCCD nhân viên của khách không nằm trong tài khoản của mình).
  driveEmail              String? // tài khoản Google đã kết nối — để màn hình nói rõ đang dùng Drive của ai
  driveRootFolderId       String? // ID thư mục gốc "maxv/<mst>-<tên cty>". Lưu ID chứ KHÔNG tra theo tên:
  // Drive cho trùng tên thư mục, và khách đổi tên/kéo thả lúc nào cũng được.
  driveRefreshTokenCipher String?
  driveRefreshTokenIv     String?
  driveRefreshTokenTag    String?

  // Owner sở hữu MST này (đếm giới hạn gói + xác định ai quản lý/nhân viên thuộc account nào)
  ownerId String
  owner   User   @relation("DonViOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Trạng thái VÒNG ĐỜI DB (tách khỏi billing — billing nằm ở Subscription của owner)
  status        TenantStatus @default(PROVISIONING)
  dbName        String?      @unique // "maxv2_<MST>_app"
  provisionedAt DateTime?

  // Nhân viên được cấp quyền truy cập MST này
  access DonViAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("don_vi")
}

// ---------------- Quyền truy cập MST của nhân viên (bảng nối User ↔ DonVi) ----------------
// Owner KHÔNG cần dòng ở đây (owner thấy hết MST của mình qua DonVi.ownerId).
// Mỗi dòng = 1 nhân viên được cấp quyền vào 1 MST cụ thể.
model DonViAccess {
  id        String   @id @default(uuid())
  userId    String
  donViId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  donVi DonVi @relation(fields: [donViId], references: [id], onDelete: Cascade)

  @@unique([userId, donViId])
  @@index([donViId])
  @@map("don_vi_access")
}

// ---------------- Gói thuê bao (danh mục) ----------------
model SubscriptionPlan {
  id           String   @id @default(uuid())
  ma           String   @unique // "TRIAL","BASIC","PRO"
  ten          String
  gia          Decimal  @default(0) @db.Decimal(18, 2)
  chuKyThang   Int      @default(1) // chu kỳ tính bằng tháng (0 = trial)
  soMstToiDa   Int? // giới hạn số công ty/MST 1 tài khoản được tạo; null = không giới hạn
  soNguoiToiDa Int? // giới hạn số user (nhân viên) trong 1 tài khoản; null = không giới hạn
  features     Json     @default("{}")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions Subscription[]
  histories     SubscriptionHistory[]

  @@map("subscription_plans")
}

// ---------------- Thuê bao hiện hành của 1 công ty ----------------
model Subscription {
  id        String             @id @default(uuid())
  ownerId   String             @unique // mỗi tài khoản (owner) 1 thuê bao hiện hành
  planId    String
  status    SubscriptionStatus @default(TRIALING)
  batDau    DateTime           @default(now())
  ketThuc   DateTime? // hết hạn kỳ hiện tại (trial/định kỳ)
  autoRenew Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  owner     User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan      @relation(fields: [planId], references: [id])
  histories SubscriptionHistory[]

  @@map("subscription")
}

// ---------------- Lịch sử thuê bao (audit billing) ----------------
model SubscriptionHistory {
  id             String   @id @default(uuid())
  subscriptionId String?
  ownerId        String // tài khoản (owner) của thuê bao
  planId         String?
  hanhDong       String // "CREATE_TRIAL","UPGRADE","RENEW","CANCEL","EXPIRE"
  giaTri         Decimal? @db.Decimal(18, 2)
  ghiChu         String?
  createdAt      DateTime @default(now())

  subscription Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@index([ownerId])
  @@map("subscription_history")
}

// ---------------- Lời mời nhân viên ----------------
model InviteRequest {
  id            String       @id @default(uuid())
  ownerId       String // tài khoản (owner) mời nhân viên vào
  email         String // email người được mời
  hoTen         String // tên do owner đặt cho người được mời (chưa chắc đã có tài khoản)
  chucVu        String // chức vụ tự do, không ràng buộc enum (vd "Kế toán trưởng")
  donViIds      String[] // các MST sẽ cấp quyền cho nhân viên khi admin duyệt (tạo DonViAccess)
  role          Role         @default(OWNER_EMPLOYEE)
  status        InviteStatus @default(PENDING)
  requestedById String // owner gửi yêu cầu
  approvedById  String? // admin duyệt (duyệt HOẶC từ chối)
  lyDoTuChoi    String? // lý do admin từ chối, hiển thị cho owner
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?

  owner User @relation("AccountInvites", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([status])
  @@map("invite_requests")
}

// ---------------- Nhật ký hệ thống ----------------
model SysLog {
  id        String   @id @default(uuid())
  level     String   @default("INFO") // INFO/WARN/ERROR
  hanhDong  String // "REGISTER","CREATE_COMPANY","LOGIN"...
  userId    String?
  donViId   String?
  chiTiet   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([donViId])
  @@index([hanhDong])
  @@map("syslog")
}

enum Role {
  ADMIN
  OWNER
  OWNER_EMPLOYEE // nhân viên do owner mời; chức vụ cụ thể nằm ở field chucVu (text tự do)
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

// Vòng đời DB của tenant (KHÔNG phải billing)
enum TenantStatus {
  PROVISIONING
  READY
  FAILED
  SUSPENDED
  ARCHIVED // owner "xóa" công ty (soft-delete) — KHÔNG xóa DB tenant, chỉ ẩn khỏi danh sách
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum InviteStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------- OTP đặt lại mật khẩu ----------------

/// OTP quên mật khẩu gửi qua email: sống ngắn, dùng đúng 1 lần, đếm số lần nhập sai.
/// Lưu HASH của OTP chứ không lưu OTP thô — rò DB không đồng nghĩa lộ mã đang hiệu lực.
model PasswordResetOtp {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  otpHash      String // bcrypt hash của mã 6 số
  /// Số lần nhập sai — chạm trần thì OTP coi như chết (chống dò 6 chữ số).
  attemptCount Int    @default(0)

  expiresAt DateTime
  /// Khác null = đã dùng để đổi mật khẩu, không dùng lại được.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Truy vấn chính: tìm OTP còn sống mới nhất của 1 user.
  @@index([userId, createdAt])
  @@map("password_reset_otps")
}
