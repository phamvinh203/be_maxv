// ============================================================
//  TEMPLATE DB CÔNG TY (db_<MST>)
//  Mỗi công ty 1 DB riêng, cùng schema này. URL được ghi đè động.
//  Chứa toàn bộ nghiệp vụ: thiết lập, danh mục, chứng từ, bút toán.
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/tenant"
}

// Prisma 7: URL không còn trong schema. Tenant push dùng `--url` động
// (xem provisioning.service.ts); runtime dùng driver adapter @prisma/adapter-pg.
datasource db {
  provider = "postgresql"
}

// ============================================================
//  TỒN KHO › DANH MỤC › HÀNG HÓA (ton-kho/dm/hang-hoa)
//  Bảng chính: dmvt + dmqddvt.
//  Lookup: dmdvt, dmloaivt, dmkho, dmnhkho, dmvitri,
//          dmthue, dmthuenk, dmnhvt.
// ============================================================

/// Danh mục vật tư / hàng hóa
model dmvt {
  ma_vt      String  @id @db.VarChar(32)
  ten_vt     String  @db.VarChar(254)
  ten_vt2    String? @db.VarChar(254)
  dvt        String  @db.VarChar(24)
  dvt2       String? @db.VarChar(24)
  he_so      Decimal @default(1) @db.Decimal(18, 4)
  he_so2     Decimal @default(1) @db.Decimal(18, 4)
  nhieu_dvt  Boolean @default(false)
  vt_ton_kho Boolean @default(true)
  lo_yn      Boolean @default(false)
  kk_yn      Boolean @default(false)
  gia_ton    Int     @default(1) // PP tính giá (mã phương pháp)

  loai_vt String? @db.VarChar(24)
  nh_vt1  String? @db.VarChar(24)
  nh_vt2  String? @db.VarChar(24)
  nh_vt3  String? @db.VarChar(24)

  ma_kho     String? @db.VarChar(24)
  ma_vi_tri  String? @db.VarChar(24)
  ma_thue    String? @db.VarChar(24)
  ma_thue_nk String? @db.VarChar(24)

  // Tài khoản hạch toán
  tk_vt     String? @db.VarChar(24)
  sua_tk_vt Boolean @default(false)
  tk_gv     String? @db.VarChar(24)
  tk_dt     String? @db.VarChar(24)
  tk_dtnb   String? @db.VarChar(24)
  tk_tl     String? @db.VarChar(24)
  tk_dl     String? @db.VarChar(24)
  tk_spdd   String? @db.VarChar(24)
  tk_cl_vt  String? @db.VarChar(24)
  tk_ck     String? @db.VarChar(24)
  tk_cpbh   String? @db.VarChar(24)

  // Quản lý lô / hạn dùng
  kieu_lo    Int     @default(1)
  cach_xuat  Int     @default(1)
  so_ngay_sp Int     @default(0)
  so_ngay_bh Int     @default(0)
  tao_lo     Boolean @default(false)

  // Định mức tồn & quy cách
  sl_min    Decimal @default(0) @db.Decimal(18, 4)
  sl_max    Decimal @default(0) @db.Decimal(18, 4)
  volume    Decimal @default(0) @db.Decimal(18, 4)
  dvtvolume String? @db.VarChar(24)
  weight    Decimal @default(0) @db.Decimal(18, 4)
  dvtweight String? @db.VarChar(24)

  ghi_chu String? @db.VarChar(512)
  status  String  @default("1") @db.VarChar(1)

  datetime0 DateTime @default(now())
  datetime2 DateTime @default(now())
  user_id0  String?  @db.VarChar(64)
  user_id2  String?  @db.VarChar(64)

  qddvt dmqddvt[]

  @@index([loai_vt])
  @@index([ma_kho])
  @@index([nh_vt1])
  @@index([nh_vt2])
  @@index([nh_vt3])
  @@index([status])
}

/// Quy đổi đơn vị tính của vật tư (nhiều ĐVT)
model dmqddvt {
  ma_vt  String  @db.VarChar(32)
  dvt    String  @db.VarChar(24)
  he_so  Decimal @default(1) @db.Decimal(18, 4)
  xtype  String  @default("S") @db.VarChar(1)
  status String  @default("1") @db.VarChar(1)

  user_id0 String? @db.VarChar(64)
  user_id2 String? @db.VarChar(64)

  vt dmvt @relation(fields: [ma_vt], references: [ma_vt], onDelete: Cascade, onUpdate: Cascade)

  @@id([ma_vt, dvt])
}

/// Danh mục đơn vị tính
model dmdvt {
  dvt      String  @id @db.VarChar(24)
  dvt2     String? @db.VarChar(24)
  ten_dvt  String  @db.VarChar(128)
  ten_dvt2 String? @db.VarChar(128)
  status   String  @default("1") @db.VarChar(1)
}

/// Danh mục loại vật tư
model dmloaivt {
  ma_loai_vt   String  @id @db.VarChar(24)
  ten_loai_vt  String  @db.VarChar(128)
  ten_loai_vt2 String? @db.VarChar(128)
  status       String  @default("1") @db.VarChar(1)
}

/// Danh mục kho
model dmkho {
  ma_kho    String  @id @db.VarChar(24)
  ma_dvcs   String  @default("001") @db.VarChar(16)
  ten_kho   String  @db.VarChar(128)
  ten_kho2  String? @db.VarChar(128)
  dai_ly_yn Boolean @default(false)
  ma_nh     String? @db.VarChar(24)
  ghi_chu   String? @db.VarChar(512)
  status    String  @default("1") @db.VarChar(1)

  @@index([ma_nh])
}

/// Danh mục nhóm kho
model dmnhkho {
  ma_nh   String  @id @db.VarChar(24)
  ten_nh  String  @db.VarChar(128)
  ten_nh2 String? @db.VarChar(128)
  status  String  @default("1") @db.VarChar(1)
}

/// Danh mục vị trí trong kho
model dmvitri {
  ma_kho      String  @db.VarChar(24)
  ma_vi_tri   String  @db.VarChar(24)
  ten_vi_tri  String  @db.VarChar(128)
  ten_vi_tri2 String? @db.VarChar(128)
  status      String  @default("1") @db.VarChar(1)

  @@id([ma_kho, ma_vi_tri])
}

/// Danh mục thuế GTGT
model dmthue {
  ma_thue   String   @id @db.VarChar(16)
  ten_thue  String   @db.VarChar(128)
  ten_thue2 String?  @db.VarChar(128)
  ty_le     Decimal? @db.Decimal(9, 4)
  tk_thue   String?  @db.VarChar(16)
  status    String   @default("1") @db.VarChar(1)
}

/// Danh mục thuế nhập khẩu
model dmthuenk {
  ma_thue   String   @id @db.VarChar(16)
  ten_thue  String   @db.VarChar(128)
  ten_thue2 String?  @db.VarChar(128)
  thue_suat Decimal? @db.Decimal(9, 4)
  tk_thue   String?  @db.VarChar(16)
  status    String   @default("1") @db.VarChar(1)
}

/// Danh mục phân nhóm vật tư (loai_nh = 1|2|3)
model dmnhvt {
  loai_nh Int
  ma_nh   String  @db.VarChar(24)
  ten_nh  String  @db.VarChar(128)
  ten_nh2 String? @db.VarChar(128)
  status  String  @default("1") @db.VarChar(1)

  @@id([loai_nh, ma_nh])
}

/// Danh mục mã giao dịch (theo chứng từ)
model dmmagd {
  ma_ct   String  @db.VarChar(24)
  loai_ct String? @db.VarChar(24)
  ma_gd   String  @db.VarChar(24)
  ten_gd  String  @db.VarChar(254)
  ten_gd2 String? @db.VarChar(254)
  status  String  @default("1") @db.VarChar(1)

  datetime0 DateTime @default(now())
  datetime2 DateTime @default(now())

  @@id([ma_ct, ma_gd])
}

// ============================================================
//  TỔNG HỢP › DANH MỤC
// ============================================================

/// Danh mục ngoại tệ / tiền tệ
model dmnt {
  ma_nt   String  @id @db.VarChar(24)
  ten_nt  String  @db.VarChar(128)
  ten_nt2 String? @db.VarChar(128)

  // Tài khoản chênh lệch tỷ giá
  tk_pscl_no String? @db.VarChar(24)
  tk_pscl_co String? @db.VarChar(24)
  tk_dgcl_no String? @db.VarChar(24)
  tk_dgcl_co String? @db.VarChar(24)

  // Cấu hình làm tròn / định dạng số
  ra_ndec Int     @default(0)
  ra_1    String? @db.VarChar(64)
  ra_2    String? @db.VarChar(64)
  ra_3    String? @db.VarChar(64)
  ra_4    String? @db.VarChar(64)
  ra_5    String? @db.VarChar(64)
  ra_12   String? @db.VarChar(64)
  ra_22   String? @db.VarChar(64)
  ra_32   String? @db.VarChar(64)
  ra_42   String? @db.VarChar(64)
  ra_52   String? @db.VarChar(64)

  status    String   @default("1") @db.VarChar(1)
  datetime0 DateTime @default(now())
  datetime2 DateTime @default(now())
}

/// Danh mục tài khoản (hệ thống tài khoản kế toán)
model dmtk {
  tk        String  @id @db.VarChar(24)
  ten_tk    String  @db.VarChar(254)
  ten_tk2   String? @db.VarChar(254)
  ten_ngan  String? @db.VarChar(128)
  ten_ngan2 String? @db.VarChar(128)

  ma_nt   String? @db.VarChar(24) // ngoại tệ (dmnt)
  loai_tk String? @db.VarChar(8)
  tk_me   String? @db.VarChar(24) // tài khoản mẹ (tự tham chiếu)
  bac_tk  Int?
  tk_sc   String  @default("1") @db.VarChar(2)
  loai_cn String? @db.VarChar(8)
  tk_w    String? @db.VarChar(8)
  tk_td1  String? @db.VarChar(24)
  tk_cn   String  @default("0") @db.VarChar(2)

  nh_tk0     String? @db.VarChar(24)
  nh_tk2     String? @db.VarChar(24)
  loai_cl_no String? @db.VarChar(8)
  loai_cl_co String? @db.VarChar(8)

  status    String   @default("1") @db.VarChar(1)
  datetime0 DateTime @default(now())
  datetime2 DateTime @default(now())

  @@index([tk_me])
  @@index([ma_nt])
}

/// Danh mục khách hàng (dmkh) — dùng cho chứng từ bán hàng (m81.ma_kh).
model dmkh {
  ma_kh      String  @id @db.VarChar(24)
  ten_kh     String  @db.VarChar(254)
  ten_kh2    String? @db.VarChar(254)
  dia_chi    String? @db.VarChar(254)
  ma_so_thue String? @db.VarChar(24)

  status    String   @default("1") @db.VarChar(1)
  datetime0 DateTime @default(now())
  datetime2 DateTime @default(now())
}

/// Hóa đơn bán hàng — header (m81). Chi tiết dòng ở d81.
model m81 {
  stt_rec String @id @db.VarChar(32)

  ma_dvcs String? @db.VarChar(24) // đơn vị cơ sở
  ma_ct   String  @default("HB1") @db.VarChar(24) // loại chứng từ

  ngay_ct  DateTime?
  ngay_lct DateTime?
  so_ct    String    @db.VarChar(24)
  so_seri  String?   @db.VarChar(64)

  ma_kh     String  @db.VarChar(24) // khách hàng (dmkh)
  ma_kh2    String? @db.VarChar(24)
  ong_ba    String? @db.VarChar(254)
  dien_giai String? @db.VarChar(512)

  tk      String? @db.VarChar(24)
  ma_nt   String  @default("VND") @db.VarChar(24)
  ty_gia  Decimal @default(1) @db.Decimal(18, 4)
  ma_gd   String? @db.VarChar(24)
  loai_ct String? @db.VarChar(8)

  ma_nvbh    String? @db.VarChar(24) // nhân viên bán hàng
  ma_tt      String? @db.VarChar(24) // thanh toán
  ma_ht_tt   String? @db.VarChar(24) // hình thức thanh toán
  tk_thue_no String? @db.VarChar(24)
  tk_thue_co String? @db.VarChar(24)

  // Tổng hợp (nt = ngoại tệ)
  t_so_luong Decimal @default(0) @db.Decimal(18, 4)
  t_tien_nt2 Decimal @default(0) @db.Decimal(18, 4)
  t_tien2    Decimal @default(0) @db.Decimal(18, 4)
  t_ck_nt    Decimal @default(0) @db.Decimal(18, 4)
  t_ck       Decimal @default(0) @db.Decimal(18, 4)
  t_thue_nt  Decimal @default(0) @db.Decimal(18, 4)
  t_thue     Decimal @default(0) @db.Decimal(18, 4)
  t_tt_nt    Decimal @default(0) @db.Decimal(18, 4)
  t_tt       Decimal @default(0) @db.Decimal(18, 4)

  status    String   @default("2") @db.VarChar(1)
  user_id0  String?  @db.VarChar(64)
  user_id2  String?  @db.VarChar(64)
  datetime0 DateTime @default(now())
  datetime2 DateTime @default(now())

  @@index([ma_kh])
  @@index([so_ct])
  @@index([ngay_ct])
}

/// Hóa đơn bán hàng — chi tiết dòng (d81).
model d81 {
  stt_rec0 String @id @db.VarChar(32) // khóa dòng
  stt_rec  String @db.VarChar(32) // -> m81.stt_rec
  line_nbr Int

  ma_vt     String  @db.VarChar(32)
  dvt       String? @db.VarChar(24)
  km_yn     Int     @default(0) // hàng khuyến mãi
  ma_kho    String? @db.VarChar(24)
  ma_vi_tri String? @db.VarChar(24)
  ma_lo     String? @db.VarChar(24)

  so_luong Decimal @default(0) @db.Decimal(18, 4)
  gia_nt2  Decimal @default(0) @db.Decimal(18, 4)
  tien_nt2 Decimal @default(0) @db.Decimal(18, 4)
  tl_ck    Decimal @default(0) @db.Decimal(18, 4)
  ck_nt    Decimal @default(0) @db.Decimal(18, 4)

  ma_thue   String? @db.VarChar(24)
  thue_suat Decimal @default(0) @db.Decimal(18, 4)
  thue_nt   Decimal @default(0) @db.Decimal(18, 4)

  tk_dt   String? @db.VarChar(24)
  tk_ck   String? @db.VarChar(24)
  tk_thue String? @db.VarChar(24)

  px_gia_dd Boolean @default(false)
  gia_nt    Decimal @default(0) @db.Decimal(18, 4)
  tien_nt   Decimal @default(0) @db.Decimal(18, 4)

  tk_vt   String? @db.VarChar(24)
  tk_gv   String? @db.VarChar(24)
  tk_cpbh String? @db.VarChar(24)

  gia2 Decimal @default(0) @db.Decimal(18, 4)
  tien2 Decimal @default(0) @db.Decimal(18, 4)
  ck    Decimal @default(0) @db.Decimal(18, 4)
  thue  Decimal @default(0) @db.Decimal(18, 4)
  gia   Decimal @default(0) @db.Decimal(18, 4)
  tien  Decimal @default(0) @db.Decimal(18, 4)

  dvt2   String? @db.VarChar(24)
  he_so2 Decimal @default(0) @db.Decimal(18, 4)

  so_luong2     Decimal @default(0) @db.Decimal(18, 4)
  so_luong2_nl  Decimal @default(0) @db.Decimal(18, 4)
  so_luong_giao Decimal @default(0) @db.Decimal(18, 4)
  so_luong_hh   Decimal @default(0) @db.Decimal(18, 4)
  ty_le_hh      Decimal @default(0) @db.Decimal(18, 4)

  gia_khay_nt  Decimal @default(0) @db.Decimal(18, 4)
  gia_khay     Decimal @default(0) @db.Decimal(18, 4)
  tien_khay_nt Decimal @default(0) @db.Decimal(18, 4)
  tien_khay    Decimal @default(0) @db.Decimal(18, 4)
  tien_no_nt   Decimal @default(0) @db.Decimal(18, 4)
  tien_no      Decimal @default(0) @db.Decimal(18, 4)

  ma_dhb   String? @db.VarChar(32)
  ma_du_an String? @db.VarChar(24) // dự án
  ma_pb    String? @db.VarChar(24) // phòng ban (dmpb.ma_pb)

  @@index([stt_rec])
}

// ============================================================
//  HÓA ĐƠN ĐIỆN TỬ (HDDT) › CACHE TRA CỨU GDT
// ============================================================

/// Hóa đơn điện tử bán ra — cache tra cứu từ GDT (chiều "sold" — mình là bên bán).
/// Cùng chiến lược cột chính + `raw` như vct60view (hóa đơn mua vào), không cần cột
/// `chieu` vì bảng này chỉ chứa 1 chiều cố định.
model vct50view {
  id String @id @db.VarChar(64) // id hóa đơn bên GDT

  khmshdon String  @db.VarChar(16) // Ký hiệu mẫu số hóa đơn
  khhdon   String  @db.VarChar(32) // Ký hiệu hóa đơn
  shdon    String  @db.VarChar(32) // Số hóa đơn
  mhdon    String? @db.VarChar(128) // Mã hóa đơn (tra cứu)

  tdlap DateTime // Ngày lập
  nky   DateTime? // Ngày người bán ký số

  nbmst  String  @db.VarChar(24) // MST người bán
  nbten  String  @db.VarChar(254)
  nbdchi String? @db.VarChar(512)

  nmmst  String? @db.VarChar(24) // MST người mua
  nmten  String? @db.VarChar(254)
  nmdchi String? @db.VarChar(512)
  nmcmnd String? @db.VarChar(32) // CCCD/giấy tờ người mua (cá nhân)

  dvtte String?  @db.VarChar(16) // Đơn vị tiền tệ
  tgia  Decimal? @db.Decimal(18, 4)

  tgtcthue Decimal? @db.Decimal(18, 2) // Tổng tiền chưa thuế
  tgtthue  Decimal? @db.Decimal(18, 2) // Tổng tiền thuế
  ttcktmai Decimal? @db.Decimal(18, 2) // Tổng chiết khấu thương mại
  tgtphi   Decimal? @db.Decimal(18, 2) // Tổng phí
  tgtttbso Decimal? @db.Decimal(18, 2) // Tổng tiền thanh toán

  tthai String? @db.VarChar(8) // Trạng thái hóa đơn (mã)
  ttxly String? @db.VarChar(8) // Kết quả kiểm tra hóa đơn (mã)

  thtttoan String? @db.VarChar(32) // Hình thức thanh toán
  gchu     String? @db.VarChar(1024) // Ghi chú

  detail Json?   // Chi tiết hóa đơn tải riêng từ GDT (/query/invoices/detail); null nếu chưa tải
  tt_tai String? @db.VarChar(16) // Trạng thái tải chi tiết: "OK" | "error"

  /// Hóa đơn XML GỐC đã ký số (rút từ gói ZIP của /query/invoices/export-xml).
  /// Cache vĩnh viễn: hóa đơn đã ký là BẤT BIẾN nên tải một lần dùng mãi — lượt xuất file lần sau
  /// không cần gọi lại cổng thuế (~3 giây/hóa đơn) và không cần token GDT.
  /// ~13KB/hóa đơn, Postgres tự nén (TOAST) nên thực tế nhỏ hơn nhiều.
  xml_goc String? @db.Text

  raw Json // Toàn bộ payload GDT gốc — đầy đủ mọi field, kể cả field mới phát sinh sau này

  datetime0 DateTime @default(now())
  datetime2 DateTime @updatedAt

  @@unique([nbmst, khmshdon, khhdon, shdon])
  @@index([tdlap])
  @@index([nmmst])
}

/// Hóa đơn điện tử mua vào — cache tra cứu từ GDT (chiều "purchase" — mình là bên mua).
/// Cùng chiến lược cột chính + `raw` như vct50view, không cần cột `chieu` vì bảng
/// này chỉ chứa 1 chiều cố định.
model vct60view {
  id String @id @db.VarChar(64) // id hóa đơn bên GDT

  khmshdon String  @db.VarChar(16) // Ký hiệu mẫu số hóa đơn
  khhdon   String  @db.VarChar(32) // Ký hiệu hóa đơn
  shdon    String  @db.VarChar(32) // Số hóa đơn
  mhdon    String? @db.VarChar(128) // Mã hóa đơn (tra cứu)

  tdlap DateTime // Ngày lập
  nky   DateTime? // Ngày người bán ký số

  nbmst  String  @db.VarChar(24) // MST người bán (đối tác)
  nbten  String  @db.VarChar(254)
  nbdchi String? @db.VarChar(512)

  nmmst  String? @db.VarChar(24) // MST người mua (mình)
  nmten  String? @db.VarChar(254)
  nmdchi String? @db.VarChar(512)
  nmcmnd String? @db.VarChar(32) // CCCD/giấy tờ người mua (cá nhân)

  dvtte String?  @db.VarChar(16) // Đơn vị tiền tệ
  tgia  Decimal? @db.Decimal(18, 4)

  tgtcthue Decimal? @db.Decimal(18, 2) // Tổng tiền chưa thuế
  tgtthue  Decimal? @db.Decimal(18, 2) // Tổng tiền thuế
  ttcktmai Decimal? @db.Decimal(18, 2) // Tổng chiết khấu thương mại
  tgtphi   Decimal? @db.Decimal(18, 2) // Tổng phí
  tgtttbso Decimal? @db.Decimal(18, 2) // Tổng tiền thanh toán

  tthai String? @db.VarChar(8) // Trạng thái hóa đơn (mã)
  ttxly String? @db.VarChar(8) // Kết quả kiểm tra hóa đơn (mã)

  thtttoan String? @db.VarChar(32) // Hình thức thanh toán
  gchu     String? @db.VarChar(1024) // Ghi chú

  detail Json?   // Chi tiết hóa đơn tải riêng từ GDT (/query/invoices/detail); null nếu chưa tải
  tt_tai String? @db.VarChar(16) // Trạng thái tải chi tiết: "OK" | "error"

  /// Hóa đơn XML GỐC đã ký số (rút từ gói ZIP của /query/invoices/export-xml).
  /// Cache vĩnh viễn: hóa đơn đã ký là BẤT BIẾN nên tải một lần dùng mãi — lượt xuất file lần sau
  /// không cần gọi lại cổng thuế (~3 giây/hóa đơn) và không cần token GDT.
  /// ~13KB/hóa đơn, Postgres tự nén (TOAST) nên thực tế nhỏ hơn nhiều.
  xml_goc String? @db.Text

  raw Json // Toàn bộ payload GDT gốc — đầy đủ mọi field, kể cả field mới phát sinh sau này

  datetime0 DateTime @default(now())
  datetime2 DateTime @updatedAt

  @@unique([nbmst, khmshdon, khhdon, shdon])
  @@index([tdlap])
  @@index([nmmst])
}

/// Danh mục phòng ban (dmpb) — thuộc Tổng hợp, dùng CHUNG với HRM.
/// fe_maxv nhập các cột kế toán (dia_chi, ma_td1…); HRM nhập ten_pb / ma_pb_me / ghi_chu.
model dmpb {
  ma_pb      String  @id @db.VarChar(24)
  ten_pb     String  @db.VarChar(254)
  ten_pb2    String? @db.VarChar(254) // tên khác
  dia_chi    String? @db.VarChar(254)
  dien_thoai String? @db.VarChar(32)
  ma_td1     String? @db.VarChar(24) // TK chi phí (dmtk)
  ten_tk     String? @db.VarChar(254) // tên tài khoản
  ghi_chu    String? @db.VarChar(512) // HRM hiển thị dưới nhãn "Mô tả"
  ma_pb_me   String? @db.VarChar(24) // trực thuộc — null = phòng ban gốc (dmpb.ma_pb)

  status    String   @default("1") @db.VarChar(1)
  datetime0 DateTime @default(now())
  datetime2 DateTime @default(now())

  @@index([ma_pb_me])
}

/// Lịch sử đồng bộ hóa đơn từ hệ thống HĐĐT (GDT) — mỗi lần bấm "Đồng bộ" ghi 1 dòng.
model sync_log {
  id         String   @id @db.VarChar(64)
  tu_ngay    DateTime // Từ ngày (khoảng đồng bộ)
  den_ngay   DateTime // Đến ngày
  direction  String   @db.VarChar(16) // all | purchase | sold
  loai       String   @db.VarChar(24) // all | except_ctt | only_ctt (ctt = hóa đơn máy tính tiền)
  tong       Int      @default(0) // Tổng số hóa đơn GDT báo có trong khoảng
  da_luu     Int      @default(0) // Số hóa đơn thực sự đã lưu (upsert) vào DB
  trang_thai String   @db.VarChar(16) // done | partial
  dien_giai  String?  @db.VarChar(512) // Mô tả ngắn / lý do nếu chưa hoàn thành

  created_at DateTime @default(now())

  @@index([created_at])
}

// ============================================================
//  HRM › DANH MỤC NHÂN SỰ
//  Phòng ban KHÔNG có bảng riêng — dùng chung dmpb (cột ma_pb_me).
//  Lát 1 chỉ tạo bảng nhân viên để đếm; màn hình nhân viên ở lát 2.
// ============================================================

/// Danh mục nhân viên (HRM). Liên kết dmpb qua ma_pb, hrm_chuc_vu qua ma_cv (lát 2).
model hrm_nhan_vien {
  ma_nv  String @id @db.VarChar(24)
  ho_ten String @db.VarChar(254)

  // Thông tin cá nhân
  so_cccd     String?   @db.VarChar(24) // KHÔNG unique: hồ sơ nhập dần, nhiều NV chưa có CCCD
  mst_ca_nhan String?   @db.VarChar(24)
  ngay_sinh   DateTime?
  gioi_tinh   String?   @db.VarChar(8) // nam | nu | khac
  dien_thoai  String?   @db.VarChar(32)
  email       String?   @db.VarChar(254)
  dia_chi     String?   @db.VarChar(254)
  ghi_chu     String?   @db.VarChar(512)

  // Công việc & lương
  ma_pb     String?   @db.VarChar(24) // phòng ban (dmpb)
  ma_cv     String?   @db.VarChar(24) // chức vụ (hrm_chuc_vu — lát 2)
  cap_bac   String?   @db.VarChar(64) // chữ tự do, không phải danh mục
  cong_doan Boolean   @default(false) // trích 1% phí công đoàn trên lương đóng BHXH
  ngay_vao  DateTime?

  // Tài khoản ngân hàng
  ngan_hang String? @db.VarChar(128)
  so_tk     String? @db.VarChar(32)
  chu_tk    String? @db.VarChar(254)

  status    String   @default("1") @db.VarChar(1) // 1 đang làm, 0 đã nghỉ
  datetime0 DateTime @default(now())
  datetime2 DateTime @default(now())

  @@index([ma_pb])
}

// ============================================================
//  DỊCH VỤ CÔNG › CACHE HỒ SƠ ĐÃ NỘP (dich-vu-cong)
//  Cùng chiến lược cache như vct50view: cột chính bóc sẵn + `raw` Json
//  giữ nguyên dữ liệu cổng, file cache VĨNH VIỄN trong cột Bytes
//  (bất biến sau phát hành, Postgres TOAST tự nén).
//  Phạm vi: 2 tab tờ khai. Giấy nộp tiền chưa cache (làm sau nếu cần).
// ============================================================

/// Hồ sơ tờ khai đã nộp — cache tra cứu từ cổng Dịch vụ công (dichvucong.gdt.gov.vn).
/// Upsert theo `ma_ho_so` mỗi lần tra cứu: metadata + `trang_thai` GHI ĐÈ bản mới nhất
/// (trạng thái đổi theo tiến trình xử lý), riêng `xml_to_khai_bin` đã có thì giữ nguyên.
model dvc_ho_so {
  ma_ho_so String @id @db.VarChar(64) // "Mã hồ sơ" bên cổng (FE hiện là cột "Mã giao dịch")

  /// Nguồn lấy hồ sơ trên cổng: "dvc" (tab Dịch vụ công, nộp từ 01/07/2025) hoặc "tdt" (tab Thuế
  /// điện tử, nộp trước mốc đó). Phải LƯU vì lượt "Tải file" sau này gọi endpoint khác nhau theo
  /// nguồn — xem `DUONG_DAN` ở `gdt-dvc.service.ts`; đoán lại từ `ngay_nop` là mời một lớp suy
  /// diễn nữa vào chỗ đã có sẵn câu trả lời.
  /// Mặc định "dvc": mọi dòng lưu trước khi có cột này đều đến từ tab Dịch vụ công.
  nguon String @default("dvc") @db.VarChar(8)

  ten_tthc     String? @db.VarChar(512) // Tên TTHC
  to_khai      String? @db.VarChar(512) // Tờ khai / phụ lục
  ky_tinh_thue String? @db.VarChar(32)
  loai_to_khai String? @db.VarChar(64) // Chính thức / bổ sung...
  lan_nop      String? @db.VarChar(16)
  lan_bo_sung  String? @db.VarChar(16) // "Lần nộp bổ sung" bên cổng
  ngay_nop     String? @db.VarChar(32) // Dạng thô cổng trả (dd/MM/yyyy...), không parse Date
  /// Suy từ `ngay_nop` (parse best-effort dd/MM/yyyy) CHỈ để lọc/sắp xếp theo khoảng ngày ở
  /// `timHoSoDaDongBo` — hiển thị vẫn dùng `ngay_nop` (chuỗi thô), cột này không xuất ra FE.
  ngay_nop_date DateTime? @db.Date
  noi_nop      String? @db.VarChar(254) // "Cơ quan thuế tiếp nhận"
  trang_thai   String? @db.VarChar(254) // Ghi đè mỗi lần tra cứu — KHÔNG cache vĩnh viễn

  /// Tờ khai gốc NGUYÊN BYTE (bóc từ gói ZIP của POST /tchs/downloadhoso). Cache vĩnh viễn:
  /// null = chưa tải; đã có thì lượt "Tải file" sau đọc thẳng DB, không gọi lại cổng.
  /// `Bytes` chứ không `Text` cùng lý do `dvc_tai_lieu.noi_dung_bin`: `taiXmlHoSoThuc` CÓ nhánh dự
  /// phòng trả nguyên bytes khi response không phải ZIP hợp lệ, mà nhị phân ép qua
  /// `bytes.toString("utf8")` làm Postgres từ chối cả dòng (`invalid byte sequence ... 0x00`).
  xml_to_khai_bin Bytes?
  /// MIME của `xml_to_khai_bin` — hầu hết là `application/xml`, nhưng phải lưu để không đoán bừa.
  /// null = dòng cũ chưa có cột này; đọc ra thì đoán theo đuôi `ten_file_xml`.
  content_type String? @db.VarChar(128)
  /// CŨ — chỉ còn để ĐỌC bản đã cache trước khi có `xml_to_khai_bin`; KHÔNG ghi mới vào đây nữa.
  /// Giữ lại thay vì đổi kiểu tại chỗ vì `prisma db push` sẽ DROP cột (text không cast được sang
  /// bytea), xóa sạch tờ khai đã cache trên MỌI tenant. Xem chú thích `dvc_tai_lieu.noi_dung`.
  xml_to_khai   String? @db.Text
  ten_file_xml  String? @db.VarChar(254) // Tên file thật cổng đặt, dùng lại khi trả về FE

  /// Đã đồng bộ TRỌN VẸN (xml + danh sách thông báo + nội dung TỪNG thông báo) ít nhất 1 lần.
  /// KHÔNG gồm "tệp đính kèm" — cổng chưa có bộ bóc tin cậy cho phần đó, xem `dongBoChiTietHoSo`.
  /// Cờ này CHỈ được bật sau khi mọi phần trên đã xong; thiếu dù một thông báo thì giữ false để
  /// lượt sau bù (trước đây bật sớm hơn, khiến hồ sơ thiếu thông báo không bao giờ được thử lại).
  /// true -> lượt tra cứu sau BỎ QUA mọi request cổng cho hồ sơ này (chỉ ghi đè trang_thai).
  /// Thông báo phát sinh SAU khi đã đồng bộ sẽ không tự về — đánh đổi đã chốt để giữ đúng
  /// "1 captcha, sau không làm lại"; cần thì thêm nút đồng bộ lại thủ công sau.
  da_dong_bo Boolean @default(false)

  raw Json // Nguyên dòng cổng trả ({tiêu đề cột: giá trị}) — cổng thêm cột không cần migration

  datetime0 DateTime @default(now())
  datetime2 DateTime @updatedAt

  tai_lieu dvc_tai_lieu[]

  @@index([ngay_nop_date])
}

/// Tài liệu gắn với một hồ sơ — gộp thông báo + tệp đính kèm bằng cột `loai`
/// (hai loại cùng hình dạng logic: thuộc 1 hồ sơ, có nội dung file tải sau được).
///   loai = "thong_bao":    mỗi thông báo 1 dòng, `khoa` = idTbao,
///                          `noi_dung_bin` = NGUYÊN BYTE file cổng trả (null = chưa tải).
///   loai = "tep_dinh_kem": CẢ danh sách 1 dòng/hồ sơ, `khoa` = ma_ho_so, `raw` = nguyên
///                          JSON cổng trả — hình dạng thật chưa xác nhận nên chưa tách
///                          từng tệp; cổng cũng chưa thấy endpoint tải nội dung tệp.
model dvc_tai_lieu {
  loai String @db.VarChar(16)
  khoa String @db.VarChar(64)

  ma_ho_so String  @db.VarChar(64)
  tieu_de  String? @db.VarChar(512) // Tiêu đề thông báo (vd "V/v: Tiếp nhận hồ sơ...")
  ngay_gui String? @db.VarChar(32) // Dạng thô cổng trả (vd "06:58 29/07/2026")
  /// Nội dung file NGUYÊN BYTE — null = chưa tải. Dùng `Bytes` chứ không `Text` vì cổng trả
  /// thông báo dưới nhiều định dạng: XML, nhưng cũng có PDF/ZIP. Ép nhị phân qua
  /// `bytes.toString("utf8")` để nhét vào cột Text làm Postgres từ chối cả dòng
  /// (`invalid byte sequence for encoding "UTF8": 0x00`) — file coi như không bao giờ cache được.
  noi_dung_bin Bytes?
  /// MIME cổng khai cho file (`DvcTepTaiVe.contentType`) — phải lưu kèm, không suy được từ byte.
  /// null = dòng cũ chưa có cột này; đọc ra thì đoán theo đuôi `ten_file`.
  content_type String? @db.VarChar(128)
  /// CŨ — chỉ còn để ĐỌC dữ liệu đã cache trước khi có `noi_dung_bin`; KHÔNG ghi mới vào đây nữa.
  /// Giữ lại thay vì đổi kiểu tại chỗ vì tenant DB đồng bộ bằng `prisma db push --accept-data-loss`
  /// (xem `sync-tenants.ts`): Postgres không cast được text -> bytea nên push sẽ DROP cột, xóa sạch
  /// thông báo đã cache trên MỌI tenant. Xóa cột này ở một lượt dọn riêng khi đã chắc không còn dòng
  /// nào chỉ có `noi_dung`.
  noi_dung String? @db.Text
  ten_file String? @db.VarChar(254) // Tên file thật cổng đặt khi tải

  raw Json

  datetime0 DateTime @default(now())
  datetime2 DateTime @updatedAt

  ho_so dvc_ho_so @relation(fields: [ma_ho_so], references: [ma_ho_so], onDelete: Cascade, onUpdate: Cascade)

  @@id([loai, khoa])
  @@index([ma_ho_so, loai])
}

/// Lịch sử các lượt "Đồng bộ" (nút riêng, khác tra cứu bảng thường — xem
/// `dvc-dong-bo.service.ts#ghiLichSuDongBo`).
/// Cùng vai trò `sync_log` bên HĐĐT nhưng tách bảng riêng: hai module cache khác hẳn nhau
/// (hóa đơn theo chiều mua/bán, hồ sơ theo loại giấy tờ), gộp chung sẽ phải thêm cột rỗng
/// tùy module.
model dvc_dong_bo_log {
  id String @id @db.VarChar(64)

  loai    String @db.VarChar(32) // khớp TAB_DVC.value: to-khai-dvc | giay-nop-tien
  tu_ngay DateTime
  den_ngay DateTime

  tong_ho_so   Int @default(0) // Tổng hồ sơ cổng trả trong khoảng ngày
  da_co_san    Int @default(0) // Đã cache từ trước (da_dong_bo=true) -> bỏ qua, không gọi cổng
  dong_bo_xong Int @default(0) // Hồ sơ mới đồng bộ xong trong lượt này
  loi          Int @default(0) // Hồ sơ lỗi giữa chừng (bù ở lượt sau)

  trang_thai String  @db.VarChar(16) // done | partial (loi > 0)
  dien_giai  String? @db.VarChar(512) // "Đồng bộ <loại giấy tờ> — <lý do nếu partial>"; nullable
  // như sync_log bên HĐĐT — dòng ghi TRƯỚC khi thêm cột này không có giá trị.

  created_at DateTime @default(now())

  @@index([created_at])
}

/// Một Giấy nộp tiền (GNT) đã đồng bộ từ cổng eTax GNT (thuedientu.gdt.gov.vn) — xem spec
/// docs/superpowers/specs/2026-08-25-dvc-giay-nop-tien-etax-design.md.
model dvc_giay_nop_tien {
  /// "Số tham chiếu / Mã giao dịch" — PK, dùng làm định danh dòng cho FE (khớp cột hiển thị,
  /// xem `BangHoSo.khoaMaGiaoDich`). Giả định UNIQUE dựa trên tên cột cổng ("... / Mã giao dịch")
  /// — xác minh lại khi có dữ liệu thật, xem mục 7.3 của spec.
  so_tham_chieu String @id @db.VarChar(64)

  /// "id chứng từ" nội bộ cổng — dùng gọi bước detail/download (xem `taiPdfGnt`). KHÔNG lộ ra FE.
  ctu_id String @unique @db.VarChar(64)

  so_giay_nop_tien String? @db.VarChar(128)
  so_tien Decimal? @db.Decimal(18, 2)
  loai_tien String? @db.VarChar(8)
  trang_thai String? @db.VarChar(254)
  so_chung_tu String? @db.VarChar(128)
  ngay_lap_gnt String? @db.VarChar(32)
  /// Suy từ "Ngày lập GNT" (best-effort) CHỈ để lọc/sắp theo khoảng ngày — cột nào đúng nhất trong
  /// 4 cột ngày của GNT (lập/gửi/nộp thuế/nộp DS chi tiết) cần xác minh, xem mục 7.6 của spec.
  ngay_nop_date DateTime? @db.Date
  ngan_hang String? @db.VarChar(254)
  tai_khoan_ngan_hang String? @db.VarChar(64)

  /// PDF cache — mẫu giống `dvc_ho_so.xml_to_khai_bin`, null = chưa tải.
  file_pdf_bin Bytes?
  content_type String? @db.VarChar(128)
  ten_file String? @db.VarChar(254)

  /// Nguyên dòng cổng trả ({tiêu đề cột: giá trị}) — cổng thêm cột không cần migration.
  raw Json
  da_dong_bo Boolean @default(false)

  datetime0 DateTime @default(now())
  datetime2 DateTime @updatedAt

  @@index([ngay_nop_date])
}

// ============================================================
//  TỜ KHAI › ĐÁNH DẤU HÓA ĐƠN THUỘC KỲ KÊ KHAI
// ============================================================

/// Hóa đơn nào được kê khai vào kỳ nào — CHỈ lưu QUYẾT ĐỊNH, không chép số liệu hóa đơn.
///
/// Cố ý không có cột tiền/tên đối tác: mọi số đọc thẳng từ `vct50view`/`vct60view` lúc hiển thị.
/// Chép sang đây sẽ tạo bản thứ hai của cùng một hóa đơn, mà hóa đơn BỊ THAY THẾ / ĐIỀU CHỈNH /
/// HỦY sau khi đã kê khai là chuyện thường xuyên — bản chép nằm im với số cũ và không ai thấy.
/// Giữ dạng đánh dấu thì lượt xem sau luôn ra số mới nhất, và phát hiện được "hóa đơn đã kê khai
/// nay bị thay thế".
///
/// Khóa chính `[hoa_don_id, chieu]`: một hóa đơn thuộc ĐÚNG một kỳ. Kê khai lại vào kỳ khác thì
/// ghi đè dòng cũ, không sinh dòng thứ hai (tránh một hóa đơn nằm ở hai kỳ, kê khai trùng).
/// `chieu` nằm trong khóa vì id do GDT cấp chỉ duy nhất trong phạm vi một chiều.
model tokhai_ky_hoa_don {
  hoa_don_id String @db.VarChar(64)
  chieu      String @db.VarChar(8) // purchase (mua vào) | sold (bán ra)

  nam     Int
  ky_loai String @db.VarChar(8) // thang | quy
  ky_so   Int // 1..12 (tháng) hoặc 1..4 (quý)

  /// Cột "Kê khai/không kê khai" trên bảng kê. Mặc định true khi vừa gán kỳ; kế toán đổi được.
  ke_khai Boolean @default(true)
  /// Cột "Chỉ tiêu tăng giảm" — để trống cho tới khi kế toán chọn.
  chi_tieu_tang_giam String? @db.VarChar(32)
  ghi_chu            String? @db.VarChar(512)

  datetime0 DateTime @default(now())
  datetime2 DateTime @updatedAt

  @@id([hoa_don_id, chieu])
  @@index([nam, ky_loai, ky_so])
}

/// Một bản tờ khai 01/GTGT do phần mềm lập cho MỘT kỳ tính thuế.
///
/// Nguồn số liệu là BẢNG KÊ CỦA KỲ (hóa đơn đã gán kỳ ở `tokhai_ky_hoa_don` và kế toán để
/// `ke_khai = true`), không phải mọi hóa đơn rơi vào khoảng ngày.
///
/// `nhap` = mở lại là tính lại từ bảng kê (đồng bộ thêm hóa đơn thì số tự cập nhật, ô đã ghi đè
/// giữ nguyên); `chot` = đóng băng số đã nộp, muốn sửa phải mở khóa.
model tokhai_gtgt01 {
  nam     Int
  ky_loai String @db.VarChar(8) // thang | quy
  ky_so   Int // 1..12 (tháng) hoặc 1..4 (quý)

  trang_thai String @default("nhap") @db.VarChar(16) // nhap | chot

  /// Bộ chỉ tiêu CUỐI — số đem đi nộp: { ct22, ct23, ..., ct43 }.
  ct Json
  /// Số máy tự tính, giữ nguyên kể cả sau khi kế toán ghi đè — để trả lời "máy ra bao nhiêu".
  ct_may Json
  /// Ô kế toán sửa tay + lý do: { ct25: { gia: 1234, lyDo: "..." } }. Lượt tính lại KHÔNG xóa.
  ghi_de Json

  /// Bản sao ba khóa cùng tên trong `ct`, bóc ra cột để truy vấn: `ct43` cho kỳ sau nối [22],
  /// `ct40`/`ct22` cho bảng danh sách kỳ. Ghi cùng lượt với `ct`, không có đường sửa riêng.
  ct22 Decimal @default(0) @db.Decimal(18, 2)
  ct40 Decimal @default(0) @db.Decimal(18, 2)
  ct43 Decimal @default(0) @db.Decimal(18, 2)

  /// [22] lấy ở đâu ra: ky_truoc (ct43 kỳ liền trước, bản ĐÃ CHỐT) | ky_truoc_nhap (kỳ trước
  /// còn nháp nên [43] còn có thể đổi — màn hình cảnh báo) | nhap_tay.
  nguon_ct22 String @default("nhap_tay") @db.VarChar(16)

  /// Phụ lục "Giảm thuế GTGT theo NQ 204/2025" của kỳ (nhóm hàng 8%) — nộp KÈM tờ khai chính khi
  /// kỳ có hàng được giảm thuế. Số liệu tính lại mỗi lượt "Tính lại"; riêng hai ô mô tả hàng hóa
  /// giữ nguyên nếu kế toán đã sửa. `null` = kỳ chưa tính hoặc không có hàng 8%.
  phu_luc Json?

  so_hd_ban Int @default(0)
  so_hd_mua Int @default(0)
  /// Số hóa đơn kế toán đã đánh "Không kê khai" — nhìn bản tờ khai là biết đã loại bao nhiêu tờ,
  /// khỏi phải mở lại bảng kê để đếm.
  so_hd_khong_ke_khai Int @default(0)
  /// Hóa đơn BÁN RA thiếu `detail` nên chưa tách được thuế suất; bản đáng tin phải là 0.
  hd_thieu_detail Int @default(0)

  /// Câu cảnh báo của lượt "Tính lại" GẦN NHẤT (`soatToKhai.ts`), vd "N hóa đơn thay thế có tổng
  /// NHỎ HƠN hóa đơn gốc". LƯU LẠI để mở lại bản cũ vẫn thấy đủ — không phải bấm "Tính lại" mới
  /// hiện, vì đây là số liệu cần người xem lại thật, không phải hiệu ứng phụ của một lượt tính.
  /// `string[]`. `null` = bản tạo trước khi có cột này, đọc lại coi như rỗng.
  canh_bao Json?

  /// Hóa đơn điều chỉnh (tthai=3, ĐÃ cộng vào `ct`) của lượt tính GẦN NHẤT, gộp cả hai chiều — chỉ
  /// để hiển thị "kiểm tra dấu trước khi chốt". Cùng lý do LƯU LẠI như `canh_bao`.
  /// `{soHd, giaTri, thue}`. `null` = bản tạo trước khi có cột này, đọc lại coi như rỗng.
  dieu_chinh Json?

  tinh_luc DateTime?

  datetime0 DateTime @default(now())
  datetime2 DateTime @updatedAt

  @@id([nam, ky_loai, ky_so])
}
